{
  "name": "ctxkeep",
  "version": "0.3.0",
  "description": "Keeps AGENTS.md, ARCHITECTURE.md, and other project docs in sync with the code: generated from tree-sitter analysis, patched incrementally, never touching human-written text.",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "ctxkeep": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/index.ts",
    "try": "tsx src/cli/index.ts try",
    "init": "tsx src/cli/index.ts init",
    "analyze": "tsx src/cli/index.ts analyze",
    "sync": "tsx src/cli/index.ts sync",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run clean && npm run build",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "better-sqlite3": "12.9.0",
    "commander": "^13.1.0",
    "diff": "^7.0.0",
    "ignore": "^6.0.2",
    "js-yaml": "^4.1.0",
    "simple-git": "^3.27.0",
    "tree-sitter": "0.21.1",
    "tree-sitter-javascript": "0.23.1",
    "tree-sitter-python": "0.21.0",
    "tree-sitter-typescript": "0.23.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/diff": "^6.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "agents.md",
    "claude.md",
    "ai",
    "coding-agents",
    "documentation",
    "architecture",
    "context",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danish-119/ctxkeep.git"
  },
  "homepage": "https://github.com/danish-119/ctxkeep#readme",
  "bugs": {
    "url": "https://github.com/danish-119/ctxkeep/issues"
  }
}
